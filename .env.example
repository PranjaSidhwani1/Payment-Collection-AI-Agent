GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
PAYMENT_API_BASE_URL=https://se-payment-verification-api.service.external.usea2.aws.prodigaltech.com

# Used to sign the Flask session cookie for the web UI (app.py). Set a
# long random value in production - Render's render.yaml auto-generates one.
FLASK_SECRET_KEY=change_me_to_a_random_string
# Local dev only - Render sets $PORT automatically.
PORT=5000
